WEB_PORT=3010
API_PORT=8010
POSTGRES_PASSWORD=logsense-local
# Optional protection for a shared workstation; the UI will request this key.
LOGSENSE_API_KEY=
# Only load a bundle trained by you; model files can execute Python code.
MODEL_PATH=
# Optional local generation; first install a model in your own Ollama instance.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=

# Optional hosted RAG generation; set both to enable. Keep your API key local.
OPENAI_API_KEY=
OPENAI_MODEL=
